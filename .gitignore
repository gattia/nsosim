# Test fixtures — large mesh/model files not checked into git
tests/fixtures/osim_models/Geometry/
tests/fixtures/osim_models/rajagopal/Geometry/
tests/fixtures/osim_models/rajagopal/*.osim
tests/fixtures/osim_models/*_settled.osim
tests/fixtures/osim_models/opensim.log

# Phase 6 generated files (large JSON audit data, forsim results, scaling XML)
scripts/phase6_rajagopal_audit/forsim_results/
scripts/phase6_rajagopal_audit/*_audit.json
scripts/phase6_rajagopal_audit/model_mapping.json
scripts/phase6_rajagopal_audit/*.xml

# Scratch SLURM outputs from wrap-fitter robustness work — diagnostic
# scripts in scratch/iter*/ are tracked individually, but the regeneratable
# mesh/osim outputs and SLURM logs are ignored.
scratch/iter*/build_isolation_*/
scratch/iter*/slurm_outputs/
scratch/iter*/last_job_id

# Claude Code internals — runtime state, never useful to track
.claude/.nfs*
.claude/scheduled_tasks.lock
.claude/worktrees/

# Convention dir for "do not commit" intermediate experiment output
# (currently ~1.5 GB: ab_outputs, pathway_b_validation, weld_collapse_comak_test)
untracked/

# Stale tempfile leak (Python tempfile.mkstemp pattern; deleted 2026-05-23)
tests/fixtures/osim_models/tmp*.osim
